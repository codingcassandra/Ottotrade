# Used by `docker compose build` to bake Supabase config into the frontend
# bundle. Copy this to .env and fill in real values (see frontend/.env.example).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Runtime-only (never a VITE_ var) — used by the frontend container's
# docker-server.js to run the Analysis tab's Gemini call server-side.
GEMINI_API_KEY=your-gemini-api-key
